# Public OAuth client ID from Google Cloud (Web application) used for Google Drive sync.
# It is not a secret. Leave empty to hide the synchronization section.
VITE_GOOGLE_CLIENT_ID=

# Public Supabase project URL and publishable key (sb_publishable_...) for the AI Edge
# Function that suggests required skills. They are not secrets. Leave empty to hide AI
# suggestions. The AI provider key (GROQ_API_KEY) is a Supabase Edge Function secret and
# must never be placed here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
